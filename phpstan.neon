includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    paths:
        - src
        - database
    # config/ is left out: Larastan reads a package's own config file as outside a config directory and
    # reports every env() call in it, which is exactly where env() belongs.
    # No baseline: a baseline is permission to be wrong.
    treatPhpDocTypesAsCertain: false
